---
import Layout from '../../../layouts/Layout.astro';
import EscudoEquipo from '../../../components/EscudoEquipo.astro';
import { formatearDia, formatearHora, HORARIO_POR_DEFINIR } from '../../../lib/fechas';
import { enlaceMapa } from '../../../lib/mapas';
import { formatearTiempo } from '../../../lib/tiempo';
import { compararDorsal } from '../../../lib/dorsal';

const { id } = Astro.params;

const { data: partido } = await Astro.locals.supabase
  .from('partidos')
  .select(
    '*, local:equipo_local_id(nombre, escudo_url, es_propio), visitante:equipo_visitante_id(nombre, escudo_url, es_propio)',
  )
  .eq('id', id)
  .single();

if (!partido) {
  return Astro.redirect('/partidos');
}

const jugado = partido.fase_actual === 'finalizado';
const propioEsLocal = partido.local?.es_propio === true;

let statsJugadoras: Array<{
  segundos: number;
  puntos: number;
  t2_metidos: number;
  t3_metidos: number;
  tl_metidos: number;
  tl_intentados: number;
  faltas: number;
  jugadora: { nombre: string; dorsal: string | null } | null;
}> = [];
let propioEquipoStats: {
  rebotes_ofensivos: number | null;
  rebotes_defensivos: number | null;
  perdidas: number | null;
  robos: number | null;
} | null = null;
let rivalEquipoStats: {
  puntos: number;
  t2_metidos: number;
  t3_metidos: number;
  tl_metidos: number;
  tl_intentados: number;
  faltas: number;
  rebotes_ofensivos: number | null;
  rebotes_defensivos: number | null;
  perdidas: number | null;
  robos: number | null;
} | null = null;
let propioTotales = { puntos: 0, t2: 0, t3: 0, tlMetidos: 0, tlIntentados: 0, faltas: 0 };

if (jugado) {
  const [{ data: statsJugadorasData }, { data: statsEquipo }] = await Promise.all([
    Astro.locals.supabase
      .from('estadisticas_jugadora')
      .select(
        'segundos, puntos, t2_metidos, t3_metidos, tl_metidos, tl_intentados, faltas, jugadora:jugadora_id(nombre, dorsal)',
      )
      .eq('partido_id', id)
      .eq('fase', 'final'),
    Astro.locals.supabase.from('estadisticas_equipo').select('*').eq('partido_id', id).eq('fase', 'final'),
  ]);

  statsJugadoras = (statsJugadorasData ?? []).sort((a, b) => compararDorsal(a.jugadora?.dorsal ?? null, b.jugadora?.dorsal ?? null));

  propioTotales = statsJugadoras.reduce(
    (acc, j) => ({
      puntos: acc.puntos + j.puntos,
      t2: acc.t2 + j.t2_metidos,
      t3: acc.t3 + j.t3_metidos,
      tlMetidos: acc.tlMetidos + j.tl_metidos,
      tlIntentados: acc.tlIntentados + j.tl_intentados,
      faltas: acc.faltas + j.faltas,
    }),
    { puntos: 0, t2: 0, t3: 0, tlMetidos: 0, tlIntentados: 0, faltas: 0 },
  );

  propioEquipoStats = statsEquipo?.find((s) => s.lado === 'propio') ?? null;
  rivalEquipoStats = statsEquipo?.find((s) => s.lado === 'rival') ?? null;
}
---

<Layout title={`${partido.local?.nombre} vs ${partido.visitante?.nombre} — Rebotia`}>
  <a href="/partidos" class="text-sm font-medium text-club-navy/70 hover:text-club-navy hover:underline">
    ← Volver al calendario
  </a>

  <div class="mt-2 flex flex-row rounded-xl border border-club-blue/30 bg-white p-6 shadow-sm">
    <div class="flex basis-[40%] flex-col items-center justify-center gap-2">
      <EscudoEquipo nombre={partido.local?.nombre ?? ''} escudoUrl={partido.local?.escudo_url} size="h-12 w-12" />
      <p class="text-center text-sm font-medium text-club-navy">{partido.local?.nombre}</p>
    </div>
    <div class="flex basis-[20%] items-center justify-center">
      <p class={`whitespace-nowrap text-xl font-bold ${jugado ? 'text-club-navy' : 'text-club-navy/30'}`}>
        {jugado ? `${partido.puntos_local}-${partido.puntos_visitante}` : 'vs'}
      </p>
    </div>
    <div class="flex basis-[40%] flex-col items-center justify-center gap-2">
      <EscudoEquipo
        nombre={partido.visitante?.nombre ?? ''}
        escudoUrl={partido.visitante?.escudo_url}
        size="h-12 w-12"
      />
      <p class="text-center text-sm font-medium text-club-navy">{partido.visitante?.nombre}</p>
    </div>
  </div>

  <p class="mt-4 text-center text-sm text-club-navy/60">
    {partido.fecha_partido
      ? `${formatearDia(partido.fecha_partido)}${partido.hora_inicio ? ` · ${formatearHora(partido.hora_inicio)}` : ''}`
      : HORARIO_POR_DEFINIR}
    {' · '}
    {partido.tipo === 'amistoso' ? 'Amistoso' : `Liga${partido.jornada != null ? ` · Jornada ${partido.jornada}` : ''}`}
  </p>

  {
    partido.ubicacion && (
      <p class="mt-1 text-center text-sm">
        <a
          href={enlaceMapa(partido.ubicacion, partido.ubicacion_url)}
          target="_blank"
          rel="noopener noreferrer"
          class="font-medium text-club-navy hover:text-club-blue hover:underline"
        >
          📍 {partido.ubicacion}
        </a>
      </p>
    )
  }

  {
    partido.fecha_partido && (partido.hora_convocatoria || partido.hora_inicio) && (
      <p class="mt-3 text-center">
        <a
          href={`/partidos/${partido.id}.ics`}
          class="inline-flex items-center gap-1 rounded-lg border border-club-blue/40 px-3 py-1.5 text-sm font-medium text-club-navy transition-colors hover:bg-club-blue/10"
        >
          📅 Añadir al calendario
        </a>
      </p>
    )
  }

  {
    !jugado ? (
      <p class="mt-6 rounded-xl border border-club-blue/30 bg-white p-6 text-center text-club-navy/70 shadow-sm">
        Este partido todavía no se ha jugado.
      </p>
    ) : (
      <>
        <section class="mt-8">
          <div class="flex items-center justify-between gap-3">
            <h2 class="text-lg font-semibold text-club-navy">Estadísticas por jugadora</h2>

            {statsJugadoras.length > 0 && (
              <div class="inline-flex overflow-hidden rounded-lg border border-club-blue/40 text-sm" role="group" aria-label="Cambiar vista">
                <button
                  type="button"
                  data-cambiar-vista="tarjetas"
                  aria-pressed="true"
                  class="px-3 py-1.5 font-medium text-club-navy transition-colors aria-pressed:bg-club-navy aria-pressed:text-club-white"
                >
                  🃏 Tarjetas
                </button>
                <button
                  type="button"
                  data-cambiar-vista="tabla"
                  aria-pressed="false"
                  class="border-l border-club-blue/40 px-3 py-1.5 font-medium text-club-navy transition-colors aria-pressed:bg-club-navy aria-pressed:text-club-white"
                >
                  📋 Tabla
                </button>
              </div>
            )}
          </div>

          {statsJugadoras.length === 0 ? (
            <p class="mt-2 rounded-xl border border-club-blue/30 bg-white p-6 text-club-navy/70 shadow-sm">
              Todavía no hay estadísticas registradas.
            </p>
          ) : (
            <>
            <div data-vista="tarjetas" class="mt-2 grid gap-3 sm:grid-cols-2">
              {statsJugadoras.map((j) => (
                <div class="rounded-xl border border-club-blue/30 bg-white p-4 shadow-sm">
                  <div class="flex items-center justify-between gap-3">
                    <div class="flex items-center gap-3">
                      {j.jugadora?.dorsal != null && (
                        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-club-navy text-sm font-bold text-club-white">
                          {j.jugadora.dorsal}
                        </span>
                      )}
                      <p class="font-semibold text-club-navy">{j.jugadora?.nombre}</p>
                    </div>
                    <p class="text-right leading-none">
                      <span class="text-3xl font-bold text-club-navy">{j.puntos}</span>
                      <span class="ml-1 text-xs text-club-navy/50">pts</span>
                    </p>
                  </div>
                  <dl class="mt-3 grid grid-cols-5 gap-1 text-center">
                    {[
                      ['Min', formatearTiempo(j.segundos)],
                      ['T2', j.t2_metidos],
                      ['T3', j.t3_metidos],
                      ['TL', `${j.tl_metidos}/${j.tl_intentados}`],
                      ['Faltas', j.faltas],
                    ].map(([etiqueta, valor]) => (
                      <div class="rounded-lg bg-club-blue/10 px-1 py-2">
                        <dt class="text-[10px] font-medium uppercase tracking-wide text-club-navy/50">{etiqueta}</dt>
                        <dd class="mt-0.5 text-sm font-semibold text-club-navy">{valor}</dd>
                      </div>
                    ))}
                  </dl>
                </div>
              ))}
            </div>

            <div data-vista="tabla" hidden class="mt-2 overflow-x-auto rounded-xl border border-club-blue/30 bg-white shadow-sm">
              <table class="w-full min-w-[640px] text-left text-sm">
                <thead>
                  <tr class="border-b border-club-blue/20 text-club-navy/60">
                    <th class="px-4 py-3 font-medium">Jugadora</th>
                    <th class="px-4 py-3 font-medium">Min</th>
                    <th class="px-4 py-3 font-medium">Pts</th>
                    <th class="px-4 py-3 font-medium">T2</th>
                    <th class="px-4 py-3 font-medium">T3</th>
                    <th class="px-4 py-3 font-medium">TL</th>
                    <th class="px-4 py-3 font-medium">Faltas</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-club-blue/10">
                  {statsJugadoras.map((j) => (
                    <tr class="text-club-navy">
                      <td class="px-4 py-3 font-medium">
                        {j.jugadora?.dorsal != null && (
                          <span class="text-club-navy/50">#{j.jugadora.dorsal} </span>
                        )}
                        {j.jugadora?.nombre}
                      </td>
                      <td class="px-4 py-3">{formatearTiempo(j.segundos)}</td>
                      <td class="px-4 py-3">{j.puntos}</td>
                      <td class="px-4 py-3">{j.t2_metidos}</td>
                      <td class="px-4 py-3">{j.t3_metidos}</td>
                      <td class="px-4 py-3">
                        {j.tl_metidos}/{j.tl_intentados}
                      </td>
                      <td class="px-4 py-3">{j.faltas}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            </>
          )}
        </section>

        <section class="mt-8">
          <h2 class="text-lg font-semibold text-club-navy">Equipo</h2>

          <div class="mt-2 overflow-x-auto rounded-xl border border-club-blue/30 bg-white shadow-sm">
            <table class="w-full min-w-[480px] text-left text-sm">
              <thead>
                <tr class="border-b border-club-blue/20 text-club-navy/60">
                  <th class="px-4 py-3 font-medium"> </th>
                  <th class="px-4 py-3 font-medium">Nosotras</th>
                  <th class="px-4 py-3 font-medium">{propioEsLocal ? partido.visitante?.nombre : partido.local?.nombre}</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-club-blue/10 text-club-navy">
                <tr>
                  <td class="px-4 py-3 text-club-navy/60">Puntos</td>
                  <td class="px-4 py-3">{propioTotales.puntos}</td>
                  <td class="px-4 py-3">{rivalEquipoStats?.puntos ?? 0}</td>
                </tr>
                <tr>
                  <td class="px-4 py-3 text-club-navy/60">T2 metidos</td>
                  <td class="px-4 py-3">{propioTotales.t2}</td>
                  <td class="px-4 py-3">{rivalEquipoStats?.t2_metidos ?? 0}</td>
                </tr>
                <tr>
                  <td class="px-4 py-3 text-club-navy/60">T3 metidos</td>
                  <td class="px-4 py-3">{propioTotales.t3}</td>
                  <td class="px-4 py-3">{rivalEquipoStats?.t3_metidos ?? 0}</td>
                </tr>
                <tr>
                  <td class="px-4 py-3 text-club-navy/60">Tiros libres</td>
                  <td class="px-4 py-3">
                    {propioTotales.tlMetidos}/{propioTotales.tlIntentados}
                  </td>
                  <td class="px-4 py-3">
                    {rivalEquipoStats?.tl_metidos ?? 0}/{rivalEquipoStats?.tl_intentados ?? 0}
                  </td>
                </tr>
                <tr>
                  <td class="px-4 py-3 text-club-navy/60">Faltas</td>
                  <td class="px-4 py-3">{propioTotales.faltas}</td>
                  <td class="px-4 py-3">{rivalEquipoStats?.faltas ?? 0}</td>
                </tr>
                <tr>
                  <td class="px-4 py-3 text-club-navy/60">Rebotes ofensivos</td>
                  <td class="px-4 py-3">{propioEquipoStats?.rebotes_ofensivos ?? '—'}</td>
                  <td class="px-4 py-3">{rivalEquipoStats?.rebotes_ofensivos ?? '—'}</td>
                </tr>
                <tr>
                  <td class="px-4 py-3 text-club-navy/60">Rebotes defensivos</td>
                  <td class="px-4 py-3">{propioEquipoStats?.rebotes_defensivos ?? '—'}</td>
                  <td class="px-4 py-3">{rivalEquipoStats?.rebotes_defensivos ?? '—'}</td>
                </tr>
                <tr>
                  <td class="px-4 py-3 text-club-navy/60">Pérdidas</td>
                  <td class="px-4 py-3">{propioEquipoStats?.perdidas ?? '—'}</td>
                  <td class="px-4 py-3">{rivalEquipoStats?.perdidas ?? '—'}</td>
                </tr>
                <tr>
                  <td class="px-4 py-3 text-club-navy/60">Robos</td>
                  <td class="px-4 py-3">{propioEquipoStats?.robos ?? '—'}</td>
                  <td class="px-4 py-3">{rivalEquipoStats?.robos ?? '—'}</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>
      </>
    )
  }
</Layout>

<script>
  const botones = document.querySelectorAll<HTMLButtonElement>('[data-cambiar-vista]');
  const vistas = document.querySelectorAll<HTMLElement>('[data-vista]');

  const mostrarVista = (nombre: string) => {
    vistas.forEach((vista) => {
      vista.hidden = vista.dataset.vista !== nombre;
    });
    botones.forEach((boton) => {
      boton.setAttribute('aria-pressed', String(boton.dataset.cambiarVista === nombre));
    });
  };

  botones.forEach((boton) => {
    boton.addEventListener('click', () => {
      const nombre = boton.dataset.cambiarVista ?? 'tarjetas';
      mostrarVista(nombre);
      try {
        localStorage.setItem('vistaEstadisticas', nombre);
      } catch {}
    });
  });

  try {
    const guardada = localStorage.getItem('vistaEstadisticas');
    if (guardada === 'tabla' || guardada === 'tarjetas') mostrarVista(guardada);
  } catch {}
</script>
