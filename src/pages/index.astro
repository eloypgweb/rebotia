---
import Layout from '../layouts/Layout.astro';
import EscudoEquipo from '../components/EscudoEquipo.astro';
import { formatearDia, formatearHora, HORARIO_POR_DEFINIR } from '../lib/fechas';

const rol = Astro.locals.perfil?.rol;
const puedeVerCoach = rol === 'admin' || rol === 'editor';

const equiposSelect =
  '*, local:equipo_local_id(nombre, escudo_url), visitante:equipo_visitante_id(nombre, escudo_url)';

const { data: proximo } = await Astro.locals.supabase
  .from('partidos')
  .select(equiposSelect)
  .neq('fase_actual', 'finalizado')
  .order('fecha_partido', { ascending: true, nullsFirst: false })
  .limit(1)
  .maybeSingle();

const { data: ultimo } = await Astro.locals.supabase
  .from('partidos')
  .select(equiposSelect)
  .eq('fase_actual', 'finalizado')
  .order('fecha_partido', { ascending: false, nullsFirst: false })
  .limit(1)
  .maybeSingle();

---

<Layout title="Rebotia">
  <div class="rounded-2xl bg-club-navy px-6 py-12 text-center text-club-white sm:px-12">
    <h1 class="text-3xl font-bold sm:text-4xl">Bienvenido a Rebotia</h1>
    <p class="mt-3 text-club-white/80">Sigue los partidos y las estadísticas del equipo.</p>
  </div>

  <img
    src="/mainimg.webp"
    alt="Rebotia"
    class="mt-8 h-56 w-full rounded-2xl object-cover object-[center_35%] sm:h-72"
  />

  {
    proximo && (
      <section class="mt-8">
        <h2 class="text-lg font-semibold text-club-navy">Próximo partido</h2>
        <div class="mt-2 rounded-xl border border-club-blue/30 bg-white p-6 shadow-sm">
          <p class="text-center text-base font-bold text-club-navy">
            {proximo.fecha_partido ? formatearDia(proximo.fecha_partido, 'completo') : HORARIO_POR_DEFINIR}
          </p>

          <div class="mt-4 flex flex-row items-center">
            <div class="flex basis-[48%] flex-col items-center justify-center gap-2">
              <EscudoEquipo nombre={proximo.local?.nombre ?? ''} escudoUrl={proximo.local?.escudo_url} size="h-20 w-20" />
              <p class="text-center text-sm font-medium text-club-navy">{proximo.local?.nombre}</p>
            </div>
            <div class="flex basis-[4%] items-center justify-center">
              <p class="text-xl font-bold text-club-navy/30">vs</p>
            </div>
            <div class="flex basis-[48%] flex-col items-center justify-center gap-2">
              <EscudoEquipo
                nombre={proximo.visitante?.nombre ?? ''}
                escudoUrl={proximo.visitante?.escudo_url}
                size="h-20 w-20"
              />
              <p class="text-center text-sm font-medium text-club-navy">{proximo.visitante?.nombre}</p>
            </div>
          </div>

          <div class="mt-4 flex flex-col items-center gap-1 text-center text-sm text-club-navy/70">
            <p>
              {proximo.tipo === 'amistoso'
                ? 'Amistoso'
                : `Liga${proximo.jornada != null ? ` · Jornada ${proximo.jornada}` : ''}`}
            </p>
            {proximo.hora_convocatoria && (
              <p class="font-bold text-club-navy">📋 Convocatoria: {formatearHora(proximo.hora_convocatoria)}</p>
            )}
            {proximo.hora_inicio && <p>🏀 Inicio del partido: {formatearHora(proximo.hora_inicio)}</p>}
          </div>
        </div>
      </section>
    )
  }

  {
    ultimo && (
      <section class="mt-8">
        <h2 class="text-lg font-semibold text-club-navy">Último partido jugado</h2>
        <div class="mt-2 rounded-xl border border-club-blue/30 bg-white p-6 shadow-sm">
          <div class="flex flex-row items-center">
            <div class="flex basis-[40%] flex-col items-center justify-center gap-2">
              <EscudoEquipo nombre={ultimo.local?.nombre ?? ''} escudoUrl={ultimo.local?.escudo_url} size="h-12 w-12" />
              <p class="text-center text-sm font-medium text-club-navy">{ultimo.local?.nombre}</p>
            </div>
            <div class="flex basis-[20%] items-center justify-center">
              <p class="whitespace-nowrap text-xl font-bold text-club-navy">
                {ultimo.puntos_local}-{ultimo.puntos_visitante}
              </p>
            </div>
            <div class="flex basis-[40%] flex-col items-center justify-center gap-2">
              <EscudoEquipo
                nombre={ultimo.visitante?.nombre ?? ''}
                escudoUrl={ultimo.visitante?.escudo_url}
                size="h-12 w-12"
              />
              <p class="text-center text-sm font-medium text-club-navy">{ultimo.visitante?.nombre}</p>
            </div>
          </div>

          <div class="mt-4 text-center">
            <a
              href={`/partidos/${ultimo.id}`}
              class="inline-block rounded-lg bg-club-navy px-4 py-2 text-sm font-semibold text-club-white transition-colors hover:bg-club-blue hover:text-club-navy"
            >
              Ver estadísticas del partido
            </a>
          </div>
        </div>
      </section>
    )
  }

  <div class="mt-8 grid gap-4 sm:grid-cols-2">
    <a
      href="/partidos"
      class="rounded-xl border border-club-blue/30 bg-white p-6 shadow-sm transition-colors hover:border-club-blue hover:bg-club-blue/10"
    >
      <h2 class="text-lg font-semibold text-club-navy">Calendario de partidos</h2>
      <p class="mt-1 text-sm text-club-navy/70">Consulta el histórico de partidos y sus estadísticas.</p>
    </a>

    {
      puedeVerCoach && (
        <a
          href="/coach"
          class="rounded-xl border border-club-blue/30 bg-white p-6 shadow-sm transition-colors hover:border-club-blue hover:bg-club-blue/10"
        >
          <h2 class="text-lg font-semibold text-club-navy">Coach</h2>
          <p class="mt-1 text-sm text-club-navy/70">Gestiona equipos, jugadoras, partidos y estadísticas.</p>
        </a>
      )
    }
  </div>
</Layout>
