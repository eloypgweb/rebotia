---
import Layout from '../../../../layouts/Layout.astro';

const { id } = Astro.params;
const { user } = Astro.locals;

let convocatoriaError: string | null = null;
let comentarioError: string | null = null;

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const intent = formData.get('intent')?.toString();

  if (intent === 'convocatoria') {
    const { data: jugadorasIds } = await Astro.locals.supabase
      .from('jugadoras')
      .select('id')
      .eq('equipo_id', formData.get('equipo_id')?.toString() ?? '');

    const filas = (jugadorasIds ?? []).map((jugadora) => {
      const estado = formData.get(`estado_${jugadora.id}`)?.toString() ?? 'convocada';
      const titular = estado === 'convocada' && formData.get(`titular_${jugadora.id}`) === 'on';

      return {
        partido_id: id,
        jugadora_id: jugadora.id,
        estado,
        titular,
      };
    });

    if (filas.length > 0) {
      const { error } = await Astro.locals.supabase
        .from('convocatorias')
        .upsert(filas, { onConflict: 'partido_id,jugadora_id' });

      if (error) {
        convocatoriaError = error.message;
      } else {
        return Astro.redirect(`/coach/partidos/${id}/pre-partido`);
      }
    }
  } else if (intent === 'comentario') {
    const texto = formData.get('texto')?.toString().trim();

    if (!texto) {
      comentarioError = 'Escribe algo antes de guardar.';
    } else {
      const { error } = await Astro.locals.supabase
        .from('comentarios')
        .insert({ partido_id: id, fase: 'pre_partido', autor_id: user?.id, texto });

      if (error) {
        comentarioError = error.message;
      } else {
        return Astro.redirect(`/coach/partidos/${id}/pre-partido`);
      }
    }
  }
}

const { data: propio } = await Astro.locals.supabase
  .from('equipos')
  .select('id, nombre')
  .eq('es_propio', true)
  .limit(1)
  .maybeSingle();

const { data: jugadoras } = propio
  ? await Astro.locals.supabase
      .from('jugadoras')
      .select('id, nombre, dorsal')
      .eq('equipo_id', propio.id)
      .order('dorsal', { ascending: true, nullsFirst: false })
      .order('nombre')
  : { data: null };

const { data: convocatoriasExistentes } = await Astro.locals.supabase
  .from('convocatorias')
  .select('jugadora_id, estado, titular')
  .eq('partido_id', id);

const estadoPorJugadora = new Map((convocatoriasExistentes ?? []).map((c) => [c.jugadora_id, c]));

const { data: comentarios } = await Astro.locals.supabase
  .from('comentarios')
  .select('id, texto, created_at, autor:autor_id(nombre)')
  .eq('partido_id', id)
  .eq('fase', 'pre_partido')
  .order('created_at', { ascending: false });

const formateador = new Intl.DateTimeFormat('es-ES', { dateStyle: 'short', timeStyle: 'short' });

const inputClass =
  'rounded-lg border border-club-blue/40 px-3 py-2 text-club-navy outline-none focus:border-club-blue focus:ring-2 focus:ring-club-blue/30';
---

<Layout title="Pre-Partido — Rebotia">
  <a
    href={`/coach/partidos/${id}`}
    class="text-sm font-medium text-club-navy/70 hover:text-club-navy hover:underline"
  >
    ← Volver al partido
  </a>
  <h1 class="mt-2 text-2xl font-bold text-club-navy">Pre-Partido</h1>

  <section class="mt-6">
    <h2 class="text-lg font-semibold text-club-navy">Convocatoria</h2>

    {
      !propio ? (
        <p class="mt-2 rounded-xl border border-club-blue/30 bg-white p-6 text-club-navy/70 shadow-sm">
          Todavía no tienes marcado tu equipo propio.
        </p>
      ) : !jugadoras?.length ? (
        <p class="mt-2 rounded-xl border border-club-blue/30 bg-white p-6 text-club-navy/70 shadow-sm">
          Todavía no hay jugadoras en la plantilla.{' '}
          <a href="/coach/jugadoras/nuevo" class="font-medium text-club-navy hover:underline">
            Añade alguna
          </a>
          .
        </p>
      ) : (
        <form
          id="convocatoria-form"
          method="POST"
          class="mt-2 rounded-xl border border-club-blue/30 bg-white p-6 shadow-sm"
        >
          <input type="hidden" name="intent" value="convocatoria" />
          <input type="hidden" name="equipo_id" value={propio.id} />

          {convocatoriaError && <p class="mb-4 text-sm text-red-600">{convocatoriaError}</p>}

          <div class="divide-y divide-club-blue/20">
            {jugadoras.map((jugadora) => {
              const actual = estadoPorJugadora.get(jugadora.id);
              const estadoActual = actual?.estado ?? 'convocada';

              return (
                <div class="convocatoria-fila flex flex-wrap items-center justify-between gap-3 py-3">
                  <p class="font-medium text-club-navy">
                    {jugadora.dorsal != null && <span class="text-club-navy/50">#{jugadora.dorsal} </span>}
                    {jugadora.nombre}
                  </p>

                  <div class="flex flex-wrap items-center gap-4 text-sm">
                    <label class="flex items-center gap-1 text-club-navy">
                      <input
                        type="radio"
                        name={`estado_${jugadora.id}`}
                        value="convocada"
                        checked={estadoActual === 'convocada'}
                        class="estado-radio"
                      />
                      Convocada
                    </label>
                    <label class="flex items-center gap-1 text-club-navy">
                      <input
                        type="radio"
                        name={`estado_${jugadora.id}`}
                        value="lesionada"
                        checked={estadoActual === 'lesionada'}
                        class="estado-radio"
                      />
                      Lesionada
                    </label>
                    <label class="flex items-center gap-1 text-club-navy">
                      <input
                        type="radio"
                        name={`estado_${jugadora.id}`}
                        value="ausente"
                        checked={estadoActual === 'ausente'}
                        class="estado-radio"
                      />
                      Ausente
                    </label>
                    <label class="titular-label flex items-center gap-1 text-club-navy">
                      <input type="checkbox" name={`titular_${jugadora.id}`} checked={actual?.titular ?? false} />
                      Titular
                    </label>
                  </div>
                </div>
              );
            })}
          </div>

          <button
            type="submit"
            class="mt-4 rounded-lg bg-club-navy px-4 py-2 text-sm font-semibold text-club-white transition-colors hover:bg-club-blue hover:text-club-navy"
          >
            Guardar convocatoria
          </button>
        </form>
      )
    }
  </section>

  <section class="mt-8">
    <h2 class="text-lg font-semibold text-club-navy">Comentarios</h2>

    <form method="POST" class="mt-2 rounded-xl border border-club-blue/30 bg-white p-6 shadow-sm">
      <input type="hidden" name="intent" value="comentario" />

      {comentarioError && <p class="mb-2 text-sm text-red-600">{comentarioError}</p>}

      <label for="texto" class="text-sm font-medium text-club-navy">
        Nueva anotación
      </label>
      <textarea
        id="texto"
        name="texto"
        rows="3"
        required
        placeholder="Claves del partido, recordatorios, cosas a trabajar..."
        class={`mt-1 w-full ${inputClass}`}
      />

      <button
        type="submit"
        class="mt-3 rounded-lg bg-club-navy px-4 py-2 text-sm font-semibold text-club-white transition-colors hover:bg-club-blue hover:text-club-navy"
      >
        Añadir
      </button>
    </form>

    <div class="mt-4 divide-y divide-club-blue/20 rounded-xl border border-club-blue/30 bg-white shadow-sm">
      {comentarios?.length === 0 && <p class="p-6 text-club-navy/60">Todavía no hay comentarios.</p>}
      {
        comentarios?.map((comentario) => (
          <div class="flex items-start justify-between gap-4 px-6 py-4">
            <div>
              <p class="text-xs font-medium text-club-navy/50">
                {comentario.autor?.nombre ?? 'Alguien'} · {formateador.format(new Date(comentario.created_at))}
              </p>
              <p class="mt-1 whitespace-pre-wrap text-club-navy">{comentario.texto}</p>
            </div>
            <form method="POST" action={`/coach/partidos/${id}/comentarios/${comentario.id}/eliminar`}>
              <button type="submit" class="shrink-0 text-sm font-medium text-red-600 hover:underline">
                Eliminar
              </button>
            </form>
          </div>
        ))
      }
    </div>
  </section>

  <script>
    const form = document.getElementById('convocatoria-form');

    const actualizarFila = (fila: Element) => {
      const seleccionado = fila.querySelector<HTMLInputElement>('.estado-radio:checked');
      const titularLabel = fila.querySelector<HTMLElement>('.titular-label');
      if (!titularLabel) return;

      const esConvocada = seleccionado?.value === 'convocada';
      titularLabel.hidden = !esConvocada;

      if (!esConvocada) {
        const checkbox = titularLabel.querySelector<HTMLInputElement>('input[type="checkbox"]');
        if (checkbox) checkbox.checked = false;
      }
    };

    if (form) {
      form.querySelectorAll('.convocatoria-fila').forEach((fila) => actualizarFila(fila));

      form.addEventListener('change', (event) => {
        const target = event.target as HTMLElement;
        if (!target.classList.contains('estado-radio')) return;

        const fila = target.closest('.convocatoria-fila');
        if (fila) actualizarFila(fila);
      });
    }
  </script>
</Layout>
