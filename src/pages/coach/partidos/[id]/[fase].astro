---
import Layout from '../../../../layouts/Layout.astro';

const { id, fase } = Astro.params;

const FASES = {
  descanso: {
    titulo: 'Al descanso',
    puntos: ['Estadísticas de la 1ª parte', 'Comentarios'],
  },
  'post-partido': {
    titulo: 'Post-Partido',
    puntos: ['Estadísticas completas', 'Resultado final', 'Valoración'],
  },
} as const;

const info = fase && fase in FASES ? FASES[fase as keyof typeof FASES] : undefined;

if (!info) {
  return Astro.redirect(`/coach/partidos/${id}`);
}
---

<Layout title={`${info.titulo} — Rebotia`}>
  <a
    href={`/coach/partidos/${id}`}
    class="text-sm font-medium text-club-navy/70 hover:text-club-navy hover:underline"
  >
    ← Volver al partido
  </a>
  <h1 class="mt-2 text-2xl font-bold text-club-navy">{info.titulo}</h1>

  <div class="mt-6 rounded-xl border border-club-blue/30 bg-white p-6 text-club-navy/70 shadow-sm">
    <p>Próximamente aquí podrás rellenar:</p>
    <ul class="mt-2 list-disc pl-5">
      {info.puntos.map((punto) => <li>{punto}</li>)}
    </ul>
  </div>
</Layout>
