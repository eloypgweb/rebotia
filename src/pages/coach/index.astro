---
import Layout from '../../layouts/Layout.astro';

const { user, perfil } = Astro.locals;

const secciones = [
  { href: '/coach/equipos', titulo: 'Equipos', descripcion: 'Gestiona los equipos rivales y el propio.' },
  { href: '/coach/jugadoras', titulo: 'Jugadoras', descripcion: 'Gestiona la plantilla de jugadoras.' },
  { href: '/coach/partidos', titulo: 'Partidos', descripcion: 'Crea y consulta los partidos.' },
];
---

<Layout title="Coach — Rebotia">
  <h1 class="text-2xl font-bold text-club-navy">Zona Coach</h1>

  <div class="mt-6 flex items-center gap-4 rounded-xl border border-club-blue/30 bg-white p-6 shadow-sm">
    {
      perfil?.avatar_url ? (
        <img
          src={perfil.avatar_url}
          alt="Foto de perfil"
          class="h-12 w-12 shrink-0 rounded-full object-cover"
        />
      ) : (
        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-club-navy text-lg font-bold text-club-white">
          {(perfil?.nombre ?? user?.email ?? '?').charAt(0).toUpperCase()}
        </div>
      )
    }

    <div class="min-w-0">
      <p class="truncate font-semibold text-club-navy">{perfil?.nombre ?? user?.email}</p>
      <p class="truncate text-sm text-club-navy/60">{user?.email}</p>
    </div>

    {
      perfil?.rol && (
        <span class="ml-auto shrink-0 rounded-full bg-club-blue/15 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-club-navy">
          {perfil.rol}
        </span>
      )
    }
  </div>

  <div class="mt-6 grid gap-4 sm:grid-cols-2">
    {
      secciones.map((seccion) => (
        <a
          href={seccion.href}
          class="rounded-xl border border-club-blue/30 bg-white p-6 shadow-sm transition-colors hover:border-club-blue hover:bg-club-blue/10"
        >
          <h2 class="text-lg font-semibold text-club-navy">{seccion.titulo}</h2>
          <p class="mt-1 text-sm text-club-navy/70">{seccion.descripcion}</p>
        </a>
      ))
    }
  </div>
</Layout>
