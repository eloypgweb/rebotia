---
import Layout from '../../../layouts/Layout.astro';
import { formatearDia } from '../../../lib/fechas';
import { enlaceMapa } from '../../../lib/mapas';
import {
  lunesDeFecha,
  fechaDesdeISO,
  aFechaISO,
  esDiaEntreno,
  numeroSesion,
  horarioDeFecha,
  duracionMinutos,
} from '../../../lib/semana';
import { CATEGORIAS_TABLA_SEMANAL } from '../../../lib/objetivos';

const { fecha } = Astro.params;
const { user } = Astro.locals;

if (!fecha || !/^\d{4}-\d{2}-\d{2}$/.test(fecha) || !esDiaEntreno(fechaDesdeISO(fecha))) {
  return Astro.redirect('/coach/entrenamientos');
}

let error: string | null = null;

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const contenido = formData.get('contenido')?.toString() ?? '';
  const intensidadRaw = formData.get('intensidad')?.toString();
  const intensidad = intensidadRaw ? Number(intensidadRaw) : null;

  const { error: upsertError } = await Astro.locals.supabase
    .from('sesiones_entrenamiento')
    .upsert({ fecha, contenido, intensidad, autor_id: user?.id }, { onConflict: 'fecha' });

  if (upsertError) {
    error = upsertError.message;
  } else {
    const { data: todosObjetivos } = await Astro.locals.supabase.from('objetivos').select('id');
    const seleccionados = (todosObjetivos ?? [])
      .filter((o) => formData.get(`objetivo_${o.id}`) === 'on')
      .map((o) => ({ fecha, objetivo_id: o.id }));

    await Astro.locals.supabase.from('sesion_objetivos').delete().eq('fecha', fecha);

    if (seleccionados.length > 0) {
      const { error: errorObjetivos } = await Astro.locals.supabase.from('sesion_objetivos').insert(seleccionados);
      if (errorObjetivos) error = errorObjetivos.message;
    }

    const sinEtiquetas = (html: string) => html.replace(/<[^>]*>/g, '').replace(/&nbsp;/g, ' ').trim();

    // El orden de guardado sale del orden en que llegan los campos del
    // formulario (que es el orden visual tras arrastrar/mover filas), no de
    // los índices numéricos de sus nombres — esos solo identifican cada fila.
    const camposPorFila = new Map<string, { titulo?: string; detalle?: string; duracion?: string }>();
    const idsEnOrden: string[] = [];

    for (const [clave, valor] of formData.entries()) {
      const coincide = clave.match(/^ejercicio_(titulo|detalle|duracion)_(.+)$/);
      if (!coincide) continue;

      const [, campo, id] = coincide;
      if (!camposPorFila.has(id)) {
        camposPorFila.set(id, {});
        idsEnOrden.push(id);
      }
      camposPorFila.get(id)![campo as 'titulo' | 'detalle' | 'duracion'] = valor.toString();
    }

    const ejerciciosNuevos: { fecha: string; titulo: string; detalle: string | null; duracion_minutos: number | null; orden: number }[] = [];
    for (const id of idsEnOrden) {
      const campos = camposPorFila.get(id)!;
      const tituloHtml = campos.titulo ?? '';
      if (!sinEtiquetas(tituloHtml)) continue;

      const detalleHtml = campos.detalle ?? '';
      const duracion_minutos = campos.duracion ? Number(campos.duracion) : null;

      ejerciciosNuevos.push({
        fecha,
        titulo: tituloHtml,
        detalle: sinEtiquetas(detalleHtml) ? detalleHtml : null,
        duracion_minutos,
        orden: ejerciciosNuevos.length,
      });
    }

    await Astro.locals.supabase.from('ejercicios_sesion').delete().eq('fecha', fecha);

    if (ejerciciosNuevos.length > 0) {
      const { error: errorEjercicios } = await Astro.locals.supabase.from('ejercicios_sesion').insert(ejerciciosNuevos);
      if (errorEjercicios) error = errorEjercicios.message;
    }

    if (!error) {
      return Astro.redirect(`/coach/entrenamientos/${fecha}`);
    }
  }
}

const [{ data: sesion }, { data: objetivos }, { data: objetivosSesion }, { data: ejercicios }] = await Promise.all([
  Astro.locals.supabase.from('sesiones_entrenamiento').select('*').eq('fecha', fecha).maybeSingle(),
  Astro.locals.supabase.from('objetivos').select('id, categoria, titulo').order('orden'),
  Astro.locals.supabase.from('sesion_objetivos').select('objetivo_id').eq('fecha', fecha),
  Astro.locals.supabase.from('ejercicios_sesion').select('*').eq('fecha', fecha).order('orden'),
]);

const horario = horarioDeFecha(fechaDesdeISO(fecha));
const duracionPista = horario ? duracionMinutos(horario.horaInicioPista, horario.horaFinPista) : null;

const idsSeleccionados = new Set((objetivosSesion ?? []).map((o) => o.objetivo_id));

const categoriasTodas: { nombre: string; objetivos: typeof objetivos }[] = [];
for (const objetivo of objetivos ?? []) {
  let grupo = categoriasTodas.find((c) => c.nombre === objetivo.categoria);
  if (!grupo) {
    grupo = { nombre: objetivo.categoria, objetivos: [] };
    categoriasTodas.push(grupo);
  }
  grupo.objetivos!.push(objetivo);
}

// Actitudinales e Higiénicos no se seleccionan por sesión (ver lib/objetivos.ts).
const categorias = categoriasTodas.filter((c) => CATEGORIAS_TABLA_SEMANAL.includes(c.nombre));

// Si alguna vez se seleccionó un objetivo de esas categorías excluidas, se
// conserva (no se borra solo por haber quitado su categoría de la vista).
const objetivosExcluidosYaSeleccionados = (objetivos ?? []).filter(
  (o) => !CATEGORIAS_TABLA_SEMANAL.includes(o.categoria) && idsSeleccionados.has(o.id),
);

const lunesSemanaISO = aFechaISO(lunesDeFecha(fechaDesdeISO(fecha)));

const inputClass =
  'rounded-lg border border-club-blue/40 px-3 py-2 text-club-navy outline-none focus:border-club-blue focus:ring-2 focus:ring-club-blue/30';
---

<Layout title={`Entrenamiento — Rebotia`}>
  <a
    href={`/coach/entrenamientos?inicio=${lunesSemanaISO}`}
    class="text-sm font-medium text-club-navy/70 hover:text-club-navy hover:underline"
  >
    ← Volver a la semana
  </a>
  <h1 class="mt-2 text-2xl font-bold text-club-navy">Sesión {numeroSesion(fecha)}</h1>
  <p class="text-sm text-club-navy/60">{formatearDia(fecha, 'completo')}</p>

  {
    horario && (
      <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm text-club-navy/70">
        <a
          href={enlaceMapa(horario.pabellon, horario.pabellonUrl)}
          target="_blank"
          rel="noopener noreferrer"
          class="font-medium text-club-navy hover:text-club-blue hover:underline"
        >
          📍 {horario.pabellon}
        </a>
        <span>
          🏀 {horario.horaInicioPista}–{horario.horaFinPista} (pista)
        </span>
        {duracionPista != null && <span>⏱️ {duracionPista}'</span>}
      </div>
    )
  }

  <form method="POST" class="mt-6 flex flex-col gap-6">
    {error && <p class="text-sm text-red-600">{error}</p>}

    <section class="rounded-xl border border-club-blue/30 bg-white p-6 shadow-sm">
      <h2 class="text-sm font-semibold text-club-navy">Intensidad</h2>
      <div class="mt-2 flex items-center gap-2">
        {[1, 2, 3, 4, 5].map((n) => (
          <label class="cursor-pointer">
            <input type="radio" name="intensidad" value={n} checked={sesion?.intensidad === n} class="peer sr-only" />
            <span class="flex h-9 w-9 items-center justify-center rounded-full border border-club-blue/40 text-sm font-semibold text-club-navy transition-colors peer-checked:border-club-navy peer-checked:bg-club-navy peer-checked:text-club-white">
              {n}
            </span>
          </label>
        ))}
      </div>
    </section>

    <section class="rounded-xl border border-club-blue/30 bg-white p-6 shadow-sm">
      <h2 class="text-sm font-semibold text-club-navy">Objetivos a trabajar</h2>

      <div class="mt-3 divide-y divide-club-blue/15 rounded-xl border border-club-blue/20">
        {categorias.map((categoria) => (
          <details class="group">
            <summary class="cursor-pointer list-none px-4 py-2.5 text-sm font-medium text-club-navy/70 transition-colors hover:text-club-navy [&::-webkit-details-marker]:hidden">
              <span class="mr-1.5 inline-block text-club-navy/40 transition-transform group-open:rotate-90">▸</span>
              {categoria.nombre}
            </summary>
            <div class="flex flex-col gap-2.5 px-4 pb-3 pl-9">
              {categoria.objetivos!.map((objetivo) => (
                <label class="flex items-start gap-2.5 text-sm text-club-navy">
                  <span class="relative mt-0.5 inline-flex h-5 w-5 shrink-0">
                    <input
                      type="checkbox"
                      name={`objetivo_${objetivo.id}`}
                      checked={idsSeleccionados.has(objetivo.id)}
                      data-objetivo-checkbox
                      data-objetivo-titulo={objetivo.titulo}
                      data-categoria={categoria.nombre}
                      class="peer absolute inset-0 h-full w-full cursor-pointer opacity-0"
                    />
                    <span class="pointer-events-none absolute inset-0 rounded-md border border-club-blue/40 bg-white transition-colors peer-checked:border-club-navy peer-checked:bg-club-navy" />
                    <svg
                      class="pointer-events-none absolute inset-0 m-auto hidden h-3 w-3 text-club-white peer-checked:block"
                      viewBox="0 0 16 16"
                      fill="none"
                    >
                      <path d="M3.5 8.5L6.5 11.5L12.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </span>
                  {objetivo.titulo}
                </label>
              ))}
            </div>
          </details>
        ))}
      </div>

      {objetivosExcluidosYaSeleccionados.map((objetivo) => (
        <input type="hidden" name={`objetivo_${objetivo.id}`} value="on" />
      ))}

      <details class="mt-4 rounded-xl border border-club-blue/20">
        <summary class="cursor-pointer list-none px-4 py-2.5 text-sm font-medium text-club-navy/70 [&::-webkit-details-marker]:hidden">
          <span id="resumen-contador">Ningún objetivo añadido todavía</span>
        </summary>
        <div id="resumen-objetivos" class="flex flex-col gap-2 border-t border-club-blue/15 px-4 py-3"></div>
      </details>
    </section>

    <section class="rounded-xl border border-club-blue/30 bg-white p-6 shadow-sm">
      <h2 class="text-sm font-semibold text-club-navy">Ejercicios</h2>
      <p class="mt-1 text-xs text-club-navy/50">Usa el ⠿ para arrastrar un ejercicio, o las flechas ▲▼ para moverlo.</p>

      <div id="lista-ejercicios" class="mt-3 flex flex-col gap-2" data-siguiente-indice={(ejercicios ?? []).length}>
        {(ejercicios ?? []).map((ejercicio, i) => (
          <div class="ejercicio-fila flex flex-col gap-2 rounded-lg border border-club-blue/20 p-3">
            <div class="flex items-center justify-between gap-2">
              <div class="flex items-center gap-1">
                <button
                  type="button"
                  class="asa-arrastre cursor-grab rounded px-1.5 py-1 text-club-navy/40 hover:bg-club-blue/10"
                  draggable="true"
                  aria-label="Arrastrar para reordenar"
                >
                  ⠿
                </button>
                <button type="button" class="mover-arriba rounded px-1.5 py-1 text-club-navy/40 hover:bg-club-blue/10" aria-label="Subir">
                  ▲
                </button>
                <button type="button" class="mover-abajo rounded px-1.5 py-1 text-club-navy/40 hover:bg-club-blue/10" aria-label="Bajar">
                  ▼
                </button>
                <input
                  type="number"
                  min="0"
                  name={`ejercicio_duracion_${i}`}
                  value={ejercicio.duracion_minutos ?? ''}
                  placeholder="—"
                  class="ml-1 w-14 rounded-lg border border-club-blue/40 px-2 py-1.5 text-center text-club-navy outline-none focus:border-club-blue focus:ring-2 focus:ring-club-blue/30"
                />
                <span class="text-xs text-club-navy/40">min</span>
              </div>
              <button
                type="button"
                class="quitar-ejercicio shrink-0 text-sm font-medium text-red-600/80 hover:text-red-600"
                aria-label="Quitar ejercicio"
              >
                🗑️
              </button>
            </div>

            <div class="fila-toolbar flex flex-wrap items-center gap-1 rounded-lg border border-club-blue/20 bg-club-blue/5 p-1">
              <button type="button" data-cmd="bold" class="h-6 w-6 rounded text-xs font-bold text-club-navy hover:bg-club-blue/15" aria-label="Negrita">B</button>
              <button type="button" data-cmd="italic" class="h-6 w-6 rounded text-xs italic text-club-navy hover:bg-club-blue/15" aria-label="Cursiva">I</button>
              <button type="button" data-cmd="underline" class="h-6 w-6 rounded text-xs underline text-club-navy hover:bg-club-blue/15" aria-label="Subrayado">U</button>
              <span class="mx-0.5 h-4 w-px bg-club-blue/20" />
              <button type="button" data-color="#dc2626" class="h-4 w-4 rounded-full bg-red-600 hover:ring-2 hover:ring-red-600/40" aria-label="Rojo" />
              <button type="button" data-color="#16a34a" class="h-4 w-4 rounded-full bg-green-600 hover:ring-2 hover:ring-green-600/40" aria-label="Verde" />
              <button type="button" data-color="#2563eb" class="h-4 w-4 rounded-full bg-blue-600 hover:ring-2 hover:ring-blue-600/40" aria-label="Azul" />
              <button type="button" data-color="#000b45" class="rounded px-1.5 text-[11px] font-medium text-club-navy/60 hover:bg-club-blue/15" aria-label="Quitar color">⟲</button>
              <span class="mx-0.5 h-4 w-px bg-club-blue/20" />
              <button type="button" data-insert="→" class="h-6 w-6 rounded text-xs text-club-navy hover:bg-club-blue/15" aria-label="Flecha derecha">→</button>
              <button type="button" data-insert="←" class="h-6 w-6 rounded text-xs text-club-navy hover:bg-club-blue/15" aria-label="Flecha izquierda">←</button>
              <button type="button" data-insert="↑" class="h-6 w-6 rounded text-xs text-club-navy hover:bg-club-blue/15" aria-label="Flecha arriba">↑</button>
              <button type="button" data-insert="↓" class="h-6 w-6 rounded text-xs text-club-navy hover:bg-club-blue/15" aria-label="Flecha abajo">↓</button>
            </div>

            <div class="flex flex-col gap-2">
              <div
                class={`${inputClass} rich-editor`}
                contenteditable="true"
                data-rich-editor
                data-rich-target={`ejercicio_titulo_${i}`}
                data-placeholder="Título del ejercicio"
                set:html={ejercicio.titulo}
              />
              <input type="hidden" name={`ejercicio_titulo_${i}`} value={ejercicio.titulo} />

              <div
                class={`${inputClass} rich-editor min-h-[2.5rem]`}
                contenteditable="true"
                data-rich-editor
                data-rich-target={`ejercicio_detalle_${i}`}
                data-placeholder="Detalles, normas, variantes..."
                set:html={ejercicio.detalle ?? ''}
              />
              <input type="hidden" name={`ejercicio_detalle_${i}`} value={ejercicio.detalle ?? ''} />
            </div>
          </div>
        ))}
      </div>

      <button
        type="button"
        id="btn-anadir-ejercicio"
        class="mt-3 rounded-lg border border-club-blue/40 px-4 py-2 text-sm font-medium text-club-navy transition-colors hover:bg-club-blue/10"
      >
        ➕ Añadir ejercicio
      </button>

      <template id="plantilla-barra-herramientas">
        <div class="fila-toolbar flex flex-wrap items-center gap-1 rounded-lg border border-club-blue/20 bg-club-blue/5 p-1">
          <button type="button" data-cmd="bold" class="h-6 w-6 rounded text-xs font-bold text-club-navy hover:bg-club-blue/15" aria-label="Negrita">B</button>
          <button type="button" data-cmd="italic" class="h-6 w-6 rounded text-xs italic text-club-navy hover:bg-club-blue/15" aria-label="Cursiva">I</button>
          <button type="button" data-cmd="underline" class="h-6 w-6 rounded text-xs underline text-club-navy hover:bg-club-blue/15" aria-label="Subrayado">U</button>
          <span class="mx-0.5 h-4 w-px bg-club-blue/20"></span>
          <button type="button" data-color="#dc2626" class="h-4 w-4 rounded-full bg-red-600 hover:ring-2 hover:ring-red-600/40" aria-label="Rojo"></button>
          <button type="button" data-color="#16a34a" class="h-4 w-4 rounded-full bg-green-600 hover:ring-2 hover:ring-green-600/40" aria-label="Verde"></button>
          <button type="button" data-color="#2563eb" class="h-4 w-4 rounded-full bg-blue-600 hover:ring-2 hover:ring-blue-600/40" aria-label="Azul"></button>
          <button type="button" data-color="#000b45" class="rounded px-1.5 text-[11px] font-medium text-club-navy/60 hover:bg-club-blue/15" aria-label="Quitar color">⟲</button>
          <span class="mx-0.5 h-4 w-px bg-club-blue/20"></span>
          <button type="button" data-insert="→" class="h-6 w-6 rounded text-xs text-club-navy hover:bg-club-blue/15" aria-label="Flecha derecha">→</button>
          <button type="button" data-insert="←" class="h-6 w-6 rounded text-xs text-club-navy hover:bg-club-blue/15" aria-label="Flecha izquierda">←</button>
          <button type="button" data-insert="↑" class="h-6 w-6 rounded text-xs text-club-navy hover:bg-club-blue/15" aria-label="Flecha arriba">↑</button>
          <button type="button" data-insert="↓" class="h-6 w-6 rounded text-xs text-club-navy hover:bg-club-blue/15" aria-label="Flecha abajo">↓</button>
        </div>
      </template>
    </section>

    <section class="rounded-xl border border-club-blue/30 bg-white p-6 shadow-sm">
      <div class="flex flex-col gap-1">
        <label for="contenido" class="text-sm font-medium text-club-navy">
          Notas generales
        </label>
        <textarea
          id="contenido"
          name="contenido"
          rows="8"
          placeholder="Cualquier cosa que no encaje en los ejercicios de arriba..."
          class={inputClass}
        >{sesion?.contenido ?? ''}</textarea>
      </div>
    </section>

    <button
      type="submit"
      class="self-start rounded-lg bg-club-navy px-6 py-2.5 text-sm font-semibold text-club-white transition-colors hover:bg-club-blue hover:text-club-navy"
    >
      Guardar
    </button>
  </form>
</Layout>

<style>
  [data-rich-editor] {
    min-height: 2.25rem;
    white-space: pre-wrap;
    word-break: break-word;
  }
  [data-rich-editor]:empty::before {
    content: attr(data-placeholder);
    color: rgb(0 11 69 / 0.4);
    pointer-events: none;
  }
</style>

<script>
  const casillas = Array.from(document.querySelectorAll<HTMLInputElement>('[data-objetivo-checkbox]'));
  const resumen = document.getElementById('resumen-objetivos');
  const contador = document.getElementById('resumen-contador');

  const renderizarResumen = () => {
    if (!resumen || !contador) return;
    resumen.textContent = '';

    const porCategoria = new Map<string, HTMLInputElement[]>();
    casillas.forEach((casilla) => {
      if (!casilla.checked) return;
      const categoria = casilla.dataset.categoria ?? '';
      const lista = porCategoria.get(categoria) ?? [];
      lista.push(casilla);
      porCategoria.set(categoria, lista);
    });

    const total = casillas.filter((c) => c.checked).length;
    contador.textContent =
      total === 0
        ? 'Ningún objetivo añadido todavía'
        : `🎯 ${total} objetivo${total === 1 ? '' : 's'} seleccionado${total === 1 ? '' : 's'} — ver detalle`;

    porCategoria.forEach((casillasCategoria, categoria) => {
      const bloque = document.createElement('div');

      const etiqueta = document.createElement('p');
      etiqueta.className = 'text-xs font-semibold uppercase tracking-wide text-club-navy/40';
      etiqueta.textContent = categoria;
      bloque.appendChild(etiqueta);

      const fila = document.createElement('div');
      fila.className = 'mt-1 flex flex-wrap gap-1.5';

      casillasCategoria.forEach((casilla) => {
        const chip = document.createElement('span');
        chip.className =
          'inline-flex items-center gap-1 rounded-full bg-club-blue/15 px-2 py-0.5 text-xs text-club-navy';

        const texto = document.createElement('span');
        texto.textContent = casilla.dataset.objetivoTitulo ?? '';

        const quitar = document.createElement('button');
        quitar.type = 'button';
        quitar.className = 'font-bold text-club-navy/50 hover:text-red-600';
        quitar.setAttribute('aria-label', 'Quitar');
        quitar.textContent = '×';
        quitar.addEventListener('click', () => {
          casilla.checked = false;
          renderizarResumen();
        });

        chip.append(texto, quitar);
        fila.appendChild(chip);
      });

      bloque.appendChild(fila);
      resumen.appendChild(bloque);
    });
  };

  casillas.forEach((casilla) => casilla.addEventListener('change', renderizarResumen));
  renderizarResumen();

  const listaEjercicios = document.getElementById('lista-ejercicios');
  const btnAnadirEjercicio = document.getElementById('btn-anadir-ejercicio');
  const plantillaBarra = document.getElementById('plantilla-barra-herramientas') as HTMLTemplateElement | null;
  const form = document.querySelector('form');

  const inputClase =
    'rounded-lg border border-club-blue/40 px-3 py-2 text-club-navy outline-none focus:border-club-blue focus:ring-2 focus:ring-club-blue/30';

  // --- Editores de texto enriquecido (título/detalle de cada ejercicio) ---

  const sincronizarOculto = (editor: HTMLElement) => {
    const destino = editor.dataset.richTarget;
    if (!destino) return;
    const oculto = document.querySelector<HTMLInputElement>(`input[name="${destino}"]`);
    if (oculto) oculto.value = editor.innerHTML;
  };

  const activarEditorEnriquecido = (editor: HTMLElement) => {
    editor.addEventListener('input', () => {
      if (editor.innerText.trim() === '') editor.innerHTML = '';
      sincronizarOculto(editor);
    });

    editor.addEventListener('paste', (evento) => {
      evento.preventDefault();
      const texto = evento.clipboardData?.getData('text/plain') ?? '';
      document.execCommand('insertText', false, texto);
    });

    if (editor.dataset.richTarget?.startsWith('ejercicio_titulo_')) {
      editor.addEventListener('keydown', (evento) => {
        if (evento.key === 'Enter') evento.preventDefault();
      });
    }
  };

  try {
    document.execCommand('styleWithCSS', false, true);
  } catch {}

  document.querySelectorAll<HTMLElement>('[data-rich-editor]').forEach(activarEditorEnriquecido);

  const activarBarraHerramientas = (barra: HTMLElement) => {
    barra.querySelectorAll<HTMLButtonElement>('button').forEach((boton) => {
      boton.addEventListener('mousedown', (evento) => evento.preventDefault());
      boton.addEventListener('click', () => {
        const editorActivo = document.activeElement as HTMLElement | null;
        if (!editorActivo?.hasAttribute('data-rich-editor')) return;

        const cmd = boton.dataset.cmd;
        const color = boton.dataset.color;
        const insertar = boton.dataset.insert;
        if (cmd) document.execCommand(cmd);
        if (color) document.execCommand('foreColor', false, color);
        if (insertar) document.execCommand('insertText', false, insertar);

        sincronizarOculto(editorActivo);
      });
    });
  };

  document.querySelectorAll<HTMLElement>('.fila-toolbar').forEach(activarBarraHerramientas);

  form?.addEventListener('submit', () => {
    document.querySelectorAll<HTMLElement>('[data-rich-editor]').forEach(sincronizarOculto);
  });

  // --- Añadir / quitar / reordenar ejercicios ---

  const crearEditorEnriquecido = (nombre: string, placeholder: string) => {
    const editor = document.createElement('div');
    editor.className = `${inputClase} rich-editor`;
    editor.contentEditable = 'true';
    editor.setAttribute('data-rich-editor', '');
    editor.dataset.richTarget = nombre;
    editor.dataset.placeholder = placeholder;

    const oculto = document.createElement('input');
    oculto.type = 'hidden';
    oculto.name = nombre;

    activarEditorEnriquecido(editor);
    return { editor, oculto };
  };

  const activarBotonQuitar = (fila: HTMLElement) => {
    fila.querySelector<HTMLButtonElement>('.quitar-ejercicio')?.addEventListener('click', () => fila.remove());
  };

  const activarBotonesMover = (fila: HTMLElement) => {
    fila.querySelector<HTMLButtonElement>('.mover-arriba')?.addEventListener('click', () => {
      if (fila.previousElementSibling) fila.parentElement?.insertBefore(fila, fila.previousElementSibling);
    });
    fila.querySelector<HTMLButtonElement>('.mover-abajo')?.addEventListener('click', () => {
      if (fila.nextElementSibling) fila.parentElement?.insertBefore(fila.nextElementSibling, fila);
    });
  };

  // Arrastrar y soltar (ratón/escritorio). El asa dispara el arrastre; al
  // pasar por encima de otra fila, la reordena en directo según si el
  // puntero está por encima o por debajo de su mitad.
  let filaArrastrada: HTMLElement | null = null;

  const activarArrastre = (fila: HTMLElement) => {
    const asa = fila.querySelector<HTMLElement>('.asa-arrastre');
    asa?.addEventListener('dragstart', (evento) => {
      filaArrastrada = fila;
      fila.classList.add('opacity-40');
      evento.dataTransfer?.setData('text/plain', '');
    });
    asa?.addEventListener('dragend', () => {
      fila.classList.remove('opacity-40');
      filaArrastrada = null;
    });
  };

  listaEjercicios?.addEventListener('dragover', (evento) => {
    if (!filaArrastrada || !listaEjercicios) return;
    evento.preventDefault();

    const destino = (evento.target as HTMLElement).closest<HTMLElement>('.ejercicio-fila');
    if (!destino || destino === filaArrastrada) return;

    const rect = destino.getBoundingClientRect();
    const despuesDelMedio = evento.clientY > rect.top + rect.height / 2;
    listaEjercicios.insertBefore(filaArrastrada, despuesDelMedio ? destino.nextSibling : destino);
  });

  const activarFila = (fila: HTMLElement) => {
    activarBotonQuitar(fila);
    activarBotonesMover(fila);
    activarArrastre(fila);
  };

  listaEjercicios?.querySelectorAll<HTMLElement>('.ejercicio-fila').forEach(activarFila);

  btnAnadirEjercicio?.addEventListener('click', () => {
    if (!listaEjercicios) return;
    const indice = Number(listaEjercicios.dataset.siguienteIndice ?? '0');
    listaEjercicios.dataset.siguienteIndice = String(indice + 1);

    const fila = document.createElement('div');
    fila.className = 'ejercicio-fila flex flex-col gap-2 rounded-lg border border-club-blue/20 p-3';

    const cabecera = document.createElement('div');
    cabecera.className = 'flex items-center justify-between gap-2';

    const controlesIzquierda = document.createElement('div');
    controlesIzquierda.className = 'flex items-center gap-1';

    const asa = document.createElement('button');
    asa.type = 'button';
    asa.className = 'asa-arrastre cursor-grab rounded px-1.5 py-1 text-club-navy/40 hover:bg-club-blue/10';
    asa.draggable = true;
    asa.setAttribute('aria-label', 'Arrastrar para reordenar');
    asa.textContent = '⠿';

    const btnSubir = document.createElement('button');
    btnSubir.type = 'button';
    btnSubir.className = 'mover-arriba rounded px-1.5 py-1 text-club-navy/40 hover:bg-club-blue/10';
    btnSubir.setAttribute('aria-label', 'Subir');
    btnSubir.textContent = '▲';

    const btnBajar = document.createElement('button');
    btnBajar.type = 'button';
    btnBajar.className = 'mover-abajo rounded px-1.5 py-1 text-club-navy/40 hover:bg-club-blue/10';
    btnBajar.setAttribute('aria-label', 'Bajar');
    btnBajar.textContent = '▼';

    const inputDuracion = document.createElement('input');
    inputDuracion.type = 'number';
    inputDuracion.min = '0';
    inputDuracion.name = `ejercicio_duracion_${indice}`;
    inputDuracion.placeholder = '—';
    inputDuracion.className = 'ml-1 w-14 rounded-lg border border-club-blue/40 px-2 py-1.5 text-center text-club-navy outline-none focus:border-club-blue focus:ring-2 focus:ring-club-blue/30';
    const etiquetaMin = document.createElement('span');
    etiquetaMin.className = 'text-xs text-club-navy/40';
    etiquetaMin.textContent = 'min';

    controlesIzquierda.append(asa, btnSubir, btnBajar, inputDuracion, etiquetaMin);

    const btnQuitar = document.createElement('button');
    btnQuitar.type = 'button';
    btnQuitar.className = 'quitar-ejercicio shrink-0 text-sm font-medium text-red-600/80 hover:text-red-600';
    btnQuitar.setAttribute('aria-label', 'Quitar ejercicio');
    btnQuitar.textContent = '🗑️';

    cabecera.append(controlesIzquierda, btnQuitar);

    const bloqueTexto = document.createElement('div');
    bloqueTexto.className = 'flex flex-col gap-2';
    const { editor: editorTitulo, oculto: ocultoTitulo } = crearEditorEnriquecido(`ejercicio_titulo_${indice}`, 'Título del ejercicio');
    const { editor: editorDetalle, oculto: ocultoDetalle } = crearEditorEnriquecido(`ejercicio_detalle_${indice}`, 'Detalles, normas, variantes...');
    editorDetalle.classList.add('min-h-[2.5rem]');
    bloqueTexto.append(editorTitulo, ocultoTitulo, editorDetalle, ocultoDetalle);

    fila.append(cabecera);
    if (plantillaBarra) {
      const barra = plantillaBarra.content.cloneNode(true) as DocumentFragment;
      const barraElemento = barra.querySelector<HTMLElement>('.fila-toolbar');
      fila.append(barra);
      if (barraElemento) activarBarraHerramientas(barraElemento);
    }
    fila.append(bloqueTexto);

    listaEjercicios.appendChild(fila);
    activarFila(fila);
    editorTitulo.focus();
  });
</script>
