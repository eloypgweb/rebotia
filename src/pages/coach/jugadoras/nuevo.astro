---
import Layout from '../../../layouts/Layout.astro';

if (Astro.locals.perfil?.rol !== 'admin') {
  return Astro.redirect('/coach/jugadoras');
}

let error: string | null = null;

const { data: propio } = await Astro.locals.supabase
  .from('equipos')
  .select('id, nombre')
  .eq('es_propio', true)
  .limit(1)
  .maybeSingle();

if (Astro.request.method === 'POST' && propio) {
  const formData = await Astro.request.formData();
  const nombre = formData.get('nombre')?.toString().trim();
  const dorsalRaw = formData.get('dorsal')?.toString().trim();
  const dorsal = dorsalRaw ? Number(dorsalRaw) : null;
  const posicion = formData.get('posicion')?.toString().trim() || null;

  if (!nombre) {
    error = 'El nombre es obligatorio.';
  } else {
    const { error: insertError } = await Astro.locals.supabase
      .from('jugadoras')
      .insert({ equipo_id: propio.id, nombre, dorsal, posicion });

    if (insertError) {
      error = insertError.message;
    } else {
      return Astro.redirect('/coach/jugadoras');
    }
  }
}

const inputClass =
  'rounded-lg border border-club-blue/40 px-3 py-2 text-club-navy outline-none focus:border-club-blue focus:ring-2 focus:ring-club-blue/30';
const labelClass = 'text-sm font-medium text-club-navy';
---

<Layout title="Nueva jugadora — Rebotia">
  <a href="/coach" class="text-sm font-medium text-club-navy/70 hover:text-club-navy hover:underline">
    ← Volver a Coach
  </a>
  <h1 class="mt-2 text-2xl font-bold text-club-navy">Nueva jugadora</h1>

  {
    !propio ? (
      <p class="mt-6 rounded-xl border border-club-blue/30 bg-white p-6 text-club-navy/70 shadow-sm">
        Todavía no tienes marcado tu equipo propio.{' '}
        <a href="/coach/equipos" class="font-medium text-club-navy hover:underline">
          Márcalo primero
        </a>
        .
      </p>
    ) : (
      <form
        method="POST"
        class="mt-6 flex max-w-md flex-col gap-4 rounded-xl border border-club-blue/30 bg-white p-6 shadow-sm"
      >
        {error && <p class="text-sm text-red-600">{error}</p>}

        <div class="flex flex-col gap-1">
          <span class={labelClass}>Equipo</span>
          <p class="rounded-lg border border-club-blue/20 bg-club-blue/5 px-3 py-2 text-club-navy/70">{propio.nombre}</p>
        </div>

        <div class="flex flex-col gap-1">
          <label for="nombre" class={labelClass}>
            Nombre
          </label>
          <input id="nombre" name="nombre" type="text" required class={inputClass} />
        </div>

        <div class="flex flex-col gap-1">
          <label for="dorsal" class={labelClass}>
            Dorsal
          </label>
          <input id="dorsal" name="dorsal" type="number" min="0" class={inputClass} />
        </div>

        <div class="flex flex-col gap-1">
          <label for="posicion" class={labelClass}>
            Posición
          </label>
          <input id="posicion" name="posicion" type="text" class={inputClass} />
        </div>

        <div class="mt-2 flex gap-4">
          <button
            type="submit"
            class="rounded-lg bg-club-navy px-4 py-2 font-semibold text-club-white transition-colors hover:bg-club-blue hover:text-club-navy"
          >
            Crear
          </button>
          <a href="/coach/jugadoras" class="rounded-lg px-4 py-2 font-semibold text-club-navy hover:underline">
            Cancelar
          </a>
        </div>
      </form>
    )
  }
</Layout>
