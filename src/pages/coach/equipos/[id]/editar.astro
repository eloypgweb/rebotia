---
import Layout from '../../../../layouts/Layout.astro';

const { id } = Astro.params;

let error: string | null = null;

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const nombre = formData.get('nombre')?.toString().trim();
  const categoria = formData.get('categoria')?.toString().trim() || null;
  const escudo_url = formData.get('escudo_url')?.toString().trim() || null;
  const es_propio = formData.get('es_propio') === 'on';

  if (!nombre) {
    error = 'El nombre es obligatorio.';
  } else {
    const { error: updateError } = await Astro.locals.supabase
      .from('equipos')
      .update({ nombre, categoria, escudo_url, es_propio })
      .eq('id', id);

    if (updateError) {
      error = updateError.message;
    } else {
      return Astro.redirect('/coach/equipos');
    }
  }
}

const { data: equipo } = await Astro.locals.supabase.from('equipos').select('*').eq('id', id).single();

if (!equipo) {
  return Astro.redirect('/coach/equipos');
}

const inputClass =
  'rounded-lg border border-club-blue/40 px-3 py-2 text-club-navy outline-none focus:border-club-blue focus:ring-2 focus:ring-club-blue/30';
const labelClass = 'text-sm font-medium text-club-navy';
---

<Layout title={`Editar ${equipo.nombre} — Rebotia`}>
  <h1 class="text-2xl font-bold text-club-navy">Editar equipo</h1>

  <form
    method="POST"
    class="mt-6 flex max-w-md flex-col gap-4 rounded-xl border border-club-blue/30 bg-white p-6 shadow-sm"
  >
    {error && <p class="text-sm text-red-600">{error}</p>}

    <div class="flex flex-col gap-1">
      <label for="nombre" class={labelClass}>Nombre</label>
      <input id="nombre" name="nombre" type="text" required value={equipo.nombre} class={inputClass} />
    </div>

    <div class="flex flex-col gap-1">
      <label for="categoria" class={labelClass}>Categoría</label>
      <input id="categoria" name="categoria" type="text" value={equipo.categoria ?? ''} class={inputClass} />
    </div>

    <div class="flex flex-col gap-1">
      <label for="escudo_url" class={labelClass}>URL del escudo</label>
      <input id="escudo_url" name="escudo_url" type="url" value={equipo.escudo_url ?? ''} class={inputClass} />
    </div>

    <label class="flex items-center gap-2 text-sm text-club-navy">
      <input type="checkbox" name="es_propio" checked={equipo.es_propio} class="h-4 w-4 rounded border-club-blue/40" />
      Es nuestro equipo
    </label>

    <div class="mt-2 flex gap-4">
      <button
        type="submit"
        class="rounded-lg bg-club-navy px-4 py-2 font-semibold text-club-white transition-colors hover:bg-club-blue hover:text-club-navy"
      >
        Guardar
      </button>
      <a href="/coach/equipos" class="rounded-lg px-4 py-2 font-semibold text-club-navy hover:underline">
        Cancelar
      </a>
    </div>
  </form>
</Layout>
