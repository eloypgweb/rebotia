---
import Layout from '../../../layouts/Layout.astro';

if (Astro.locals.perfil?.rol !== 'admin') {
  return Astro.redirect('/coach/objetivos');
}

let error: string | null = null;

const { data: existentes } = await Astro.locals.supabase.from('objetivos').select('categoria, orden');
const categoriasExistentes = [...new Set((existentes ?? []).map((o) => o.categoria))];
const maxOrden = (existentes ?? []).reduce((max, o) => Math.max(max, o.orden), 0);

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const categoria = formData.get('categoria')?.toString().trim();
  const titulo = formData.get('titulo')?.toString().trim();
  const descripcion = formData.get('descripcion')?.toString().trim() || null;

  if (!categoria || !titulo) {
    error = 'Categoría y título son obligatorios.';
  } else {
    const { error: insertError } = await Astro.locals.supabase
      .from('objetivos')
      .insert({ categoria, titulo, descripcion, orden: maxOrden + 1, creado_por: Astro.locals.user?.id });

    if (insertError) {
      error = insertError.message;
    } else {
      return Astro.redirect('/coach/objetivos');
    }
  }
}

const inputClass =
  'rounded-lg border border-club-blue/40 px-3 py-2 text-club-navy outline-none focus:border-club-blue focus:ring-2 focus:ring-club-blue/30';
const labelClass = 'text-sm font-medium text-club-navy';
---

<Layout title="Nuevo objetivo — Rebotia">
  <a href="/coach/objetivos" class="text-sm font-medium text-club-navy/70 hover:text-club-navy hover:underline">
    ← Volver a Objetivos
  </a>
  <h1 class="mt-2 text-2xl font-bold text-club-navy">Nuevo objetivo</h1>

  <form method="POST" class="mt-6 flex max-w-md flex-col gap-4 rounded-xl border border-club-blue/30 bg-white p-6 shadow-sm">
    {error && <p class="text-sm text-red-600">{error}</p>}

    <div class="flex flex-col gap-1">
      <label for="categoria" class={labelClass}>
        Categoría
      </label>
      <input id="categoria" name="categoria" type="text" required list="categorias-existentes" class={inputClass} />
      <datalist id="categorias-existentes">
        {categoriasExistentes.map((categoria) => <option value={categoria} />)}
      </datalist>
    </div>

    <div class="flex flex-col gap-1">
      <label for="titulo" class={labelClass}>
        Título
      </label>
      <input id="titulo" name="titulo" type="text" required class={inputClass} />
    </div>

    <div class="flex flex-col gap-1">
      <label for="descripcion" class={labelClass}>
        Descripción (opcional)
      </label>
      <textarea id="descripcion" name="descripcion" rows="3" class={inputClass} />
    </div>

    <div class="mt-2 flex gap-4">
      <button
        type="submit"
        class="rounded-lg bg-club-navy px-4 py-2 font-semibold text-club-white transition-colors hover:bg-club-blue hover:text-club-navy"
      >
        Crear
      </button>
      <a href="/coach/objetivos" class="rounded-lg px-4 py-2 font-semibold text-club-navy hover:underline">
        Cancelar
      </a>
    </div>
  </form>
</Layout>
