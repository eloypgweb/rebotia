---
import Layout from '../../../layouts/Layout.astro';

const esAdmin = Astro.locals.perfil?.rol === 'admin';
const { user } = Astro.locals;

let error: string | null = null;

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();

  const { data: actuales } = await Astro.locals.supabase
    .from('objetivos')
    .select('id, categoria, titulo, descripcion, orden, valor_actual');

  const cambios = (actuales ?? []).map((objetivo) => {
    const enTrabajo = formData.get(`en_trabajo_${objetivo.id}`) === 'on';
    const valorRaw = formData.get(`valor_${objetivo.id}`)?.toString();
    const valorActual = enTrabajo && valorRaw ? Number(valorRaw) : null;
    return { ...objetivo, en_trabajo: enTrabajo, valor_actual: valorActual, valorAnterior: objetivo.valor_actual };
  });

  const filasUpsert = cambios.map(({ id, categoria, titulo, descripcion, orden, en_trabajo, valor_actual }) => ({
    id,
    categoria,
    titulo,
    descripcion,
    orden,
    en_trabajo,
    valor_actual,
  }));

  const { error: errorUpsert } = await Astro.locals.supabase
    .from('objetivos')
    .upsert(filasUpsert, { onConflict: 'id' });

  if (errorUpsert) {
    error = errorUpsert.message;
  } else {
    const nuevasValoraciones = cambios
      .filter((c) => c.valor_actual != null && c.valor_actual !== c.valorAnterior)
      .map((c) => ({ objetivo_id: c.id, valor: c.valor_actual as number, autor_id: user?.id }));

    if (nuevasValoraciones.length > 0) {
      await Astro.locals.supabase.from('objetivos_valoraciones').insert(nuevasValoraciones);
    }

    return Astro.redirect('/coach/objetivos');
  }
}

const { data: objetivos } = await Astro.locals.supabase.from('objetivos').select('*').order('orden');

const categorias: { nombre: string; objetivos: typeof objetivos }[] = [];
for (const objetivo of objetivos ?? []) {
  let grupo = categorias.find((c) => c.nombre === objetivo.categoria);
  if (!grupo) {
    grupo = { nombre: objetivo.categoria, objetivos: [] };
    categorias.push(grupo);
  }
  grupo.objetivos!.push(objetivo);
}
---

<Layout title="Objetivos — Rebotia">
  <a href="/coach" class="text-sm font-medium text-club-navy/70 hover:text-club-navy hover:underline">
    ← Volver a Coach
  </a>

  <div class="mt-2 flex items-center justify-between">
    <h1 class="text-2xl font-bold text-club-navy">Objetivos</h1>
    {
      esAdmin && (
        <a
          href="/coach/objetivos/nuevo"
          class="rounded-lg bg-club-navy px-4 py-2 text-sm font-semibold text-club-white transition-colors hover:bg-club-blue hover:text-club-navy"
        >
          ➕ Nuevo objetivo
        </a>
      )
    }
  </div>

  <p class="mt-2 text-sm text-club-navy/60">
    Activa un objetivo con el interruptor cuando empecéis a trabajarlo, y marca del 1 al 5 cómo de afianzado lo
    tiene el equipo. Puedes dejarlo apagado si todavía no lo habéis tocado.
  </p>

  {error && <p class="mt-4 text-sm text-red-600">{error}</p>}

  {
    categorias.length === 0 ? (
      <p class="mt-6 rounded-xl border border-club-blue/30 bg-white p-6 text-club-navy/70 shadow-sm">
        Todavía no hay objetivos cargados.
      </p>
    ) : (
      <form method="POST" class="mt-6 flex flex-col gap-4">
        {categorias.map((categoria) => (
          <details open class="group rounded-xl border border-club-blue/30 bg-white shadow-sm">
            <summary class="flex cursor-pointer items-center justify-between gap-3 px-6 py-4 text-lg font-semibold text-club-navy">
              {categoria.nombre}
              <span class="text-sm font-normal text-club-navy/50">
                {categoria.objetivos!.filter((o) => o.en_trabajo).length}/{categoria.objetivos!.length} en trabajo
              </span>
            </summary>

            <div class="divide-y divide-club-blue/20 border-t border-club-blue/20">
              {categoria.objetivos!.map((objetivo) => (
                <div
                  class="objetivo-fila flex flex-wrap items-center justify-between gap-3 px-6 py-4"
                  data-objetivo-id={objetivo.id}
                >
                  <div>
                    <p class="font-medium text-club-navy">{objetivo.titulo}</p>
                    {
                      esAdmin && (
                        <div class="mt-1 flex gap-3 text-xs">
                          <a href={`/coach/objetivos/${objetivo.id}/editar`} class="font-medium text-club-navy/60 hover:text-club-navy hover:underline">
                            ✏️ Editar
                          </a>
                          <button
                            type="submit"
                            formaction={`/coach/objetivos/${objetivo.id}/eliminar`}
                            formmethod="POST"
                            onclick="return confirm('¿Eliminar este objetivo? Se perderá también su historial de valoraciones.')"
                            class="font-medium text-red-600/80 hover:text-red-600 hover:underline"
                          >
                            🗑️ Eliminar
                          </button>
                        </div>
                      )
                    }
                  </div>

                  <div class="flex items-center gap-4">
                    <div class="valor-selector flex items-center gap-1" hidden>
                      {[1, 2, 3, 4, 5].map((n) => (
                        <label class="valor-opcion cursor-pointer">
                          <input
                            type="radio"
                            name={`valor_${objetivo.id}`}
                            value={n}
                            checked={objetivo.valor_actual === n}
                            class="peer sr-only"
                          />
                          <span class="flex h-8 w-8 items-center justify-center rounded-full border border-club-blue/40 text-sm font-semibold text-club-navy transition-colors peer-checked:border-club-navy peer-checked:bg-club-navy peer-checked:text-club-white">
                            {n}
                          </span>
                        </label>
                      ))}
                    </div>

                    <label class="switch-en-trabajo relative inline-flex shrink-0 cursor-pointer items-center">
                      <input
                        type="checkbox"
                        name={`en_trabajo_${objetivo.id}`}
                        checked={objetivo.en_trabajo}
                        class="peer sr-only"
                      />
                      <span class="h-6 w-11 rounded-full bg-club-navy/20 transition-colors peer-checked:bg-club-navy" />
                      <span class="absolute left-1 h-4 w-4 rounded-full bg-white transition-transform peer-checked:translate-x-5" />
                    </label>
                  </div>
                </div>
              ))}
            </div>
          </details>
        ))}

        <button
          type="submit"
          class="self-start rounded-lg bg-club-navy px-6 py-2.5 text-sm font-semibold text-club-white transition-colors hover:bg-club-blue hover:text-club-navy"
        >
          Guardar cambios
        </button>
      </form>
    )
  }
</Layout>

<script>
  const filas = document.querySelectorAll<HTMLElement>('.objetivo-fila');

  const actualizarFila = (fila: HTMLElement) => {
    const switchInput = fila.querySelector<HTMLInputElement>('.switch-en-trabajo input');
    const selectorValor = fila.querySelector<HTMLElement>('.valor-selector');
    if (!switchInput || !selectorValor) return;

    selectorValor.hidden = !switchInput.checked;

    if (switchInput.checked) {
      const haySeleccion = selectorValor.querySelector<HTMLInputElement>('input[type="radio"]:checked');
      if (!haySeleccion) {
        const medio = selectorValor.querySelectorAll<HTMLInputElement>('input[type="radio"]')[2];
        if (medio) medio.checked = true;
      }
    }
  };

  filas.forEach((fila) => {
    actualizarFila(fila);
    const switchInput = fila.querySelector<HTMLInputElement>('.switch-en-trabajo input');
    switchInput?.addEventListener('change', () => actualizarFila(fila));
  });
</script>
